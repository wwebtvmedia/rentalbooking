# ==========================================================================
# bestflats.vip — example environment file
# Copy to `.env` and fill in real values. NEVER commit your real .env.
# Generate secrets with:  openssl rand -base64 32
# ==========================================================================

# --- Branding (frontend build args) ---
NEXT_PUBLIC_BRAND_NAME=bestflats.vip
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/

# --- Deployment environment ---
# development | production | test
NODE_ENV=production

# --- Backend ---
PORT=4000
# Body size limit for JSON requests (default 1mb)
JSON_BODY_LIMIT=1mb
# Public origin of the API (used to build absolute upload/validation URLs).
# Leave unset to derive from the request (honors X-Forwarded-Proto behind Cloudflare).
BACKEND_ORIGIN=https://api.bestflats.vip

# --- Database ---
# Internal compose network host is "mongo". Add credentials once auth is enabled:
#   mongodb://USER:PASS@mongo:27017/bestflats?authSource=admin
MONGO_URI=mongodb://mongo:27017/bestflats
# Host path for the Mongo data volume (compose). On the Pi this is the USB disk.
MONGO_DATA_DIR=./data/mongo

# --- MongoDB authentication (optional; empty = no auth) ---
# Set both to enable a root user + access control. On a FRESH data dir the image
# creates the user automatically; for an existing DB run scripts/enable_mongo_auth.sh.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# --- Core secrets (REQUIRED) ---
# Signs/validates all JWTs (admin tokens, magic links, flat-validation links).
AUTH_JWT_SECRET=change-me-openssl-rand-base64-32
# Protects per-user AES-256-GCM encryption keys and blind indexes.
MASTER_ENCRYPTION_KEY=change-me-openssl-rand-base64-32
# Secondary key for the seed endpoint (x-platform-admin-key header). Never expose as NEXT_PUBLIC in real use.
PLATFORM_ADMIN_KEY=change-me-openssl-rand-base64-32
NEXT_PUBLIC_PLATFORM_ADMIN_KEY=change-me-openssl-rand-base64-32

# --- Staff invite codes (required in production for non-guest magic links) ---
HOST_INVITE_CODE=
CONCIERGE_INVITE_CODE=
CONTRACTOR_INVITE_CODE=
# In non-production, allow host/concierge/contractor magic links without a code (default true).
ALLOW_DEV_ROLE_MAGIC_LINKS=true

# --- CORS / URLs ---
# Comma-separated allowed frontend origins.
FRONTEND_ORIGIN=https://www.bestflats.vip
# Public URL of the API, baked into the frontend at build time.
NEXT_PUBLIC_BACKEND_URL=https://api.bestflats.vip

# --- Auth / debugging ---
# Log magic-link tokens to the backend console (useful when SMTP is unavailable).
AUTH_LOG_EMAIL_TOKEN=false

# --- Google OIDC (optional; enables Google ID token auth for external agents) ---
GOOGLE_CLIENT_ID=

# --- Email / SMTP ---
# Either set SMTP_URL, or the discrete SMTP_* fields. If neither is set, dev falls
# back to an Ethereal test inbox (preview URL logged).
# SMTP_URL=smtps://user:pass@smtp.example.com:465
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
MAIL_FROM=concierge@bestflats.vip
# Allow the Ethereal fallback even in production (testing only).
ALLOW_ETHEREAL_IN_PRODUCTION=false

# --- Admin notifications ---
# Recipient of host-flat validation emails. Falls back to MAIL_FROM, then admin@bestflats.vip.
ADMIN_EMAIL=

# --- Stripe payments (optional) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# --- Business logic ---
# Default booking deposit in cents (0 disables). E.g. 50000 = $500.00
DEPOSIT_DEFAULT_AMOUNT=0

# --- MCP (Model Context Protocol) ---
ENABLE_MCP_SSE=true
MCP_PORT=8999

# --- Build metadata (baked at image build by start.sh; surfaced via GET /version) ---
GIT_COMMIT=unknown
BUILD_TIME=unknown

# ==========================================================================
# Backup script env (scripts/backup_mongo.sh) — set per-run or in cron, not loaded by the app:
#   BACKUP_DIR=/mnt/usb/bfs-backups   # where local archives are written
#   KEEP=30                           # how many recent archives to retain (local + remote)
#   RCLONE_REMOTE=gdrive:bfs-backups  # off-site copy target (run `rclone config` first)
# ==========================================================================
